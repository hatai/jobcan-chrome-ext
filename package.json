{
  "name": "jobcan-chrome-ext",
  "version": "1.0.0",
  "private": true,
  "description": "Jobcanの工数入力画面のUXを改善するChrome拡張",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "build": "rolldown -c",
    "watch": "rolldown -c --watch",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "check": "biome check --write ./src",
    "check:ci": "biome ci ./src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@vitest/coverage-v8": "^4.1.7",
    "happy-dom": "^20.9.0",
    "rolldown": "^1.0.3",
    "rollup-plugin-copy": "^3.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
